# --- Data backend -----------------------------------------------------------
# "firestore" (default) uses Application Default Credentials.
# "memory" uses an in-process seeded store (local dev / demos only; not persisted).
DATA_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=my-gcp-project
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=tasks
# FIRESTORE_EMULATOR_HOST=localhost:8081

# --- Auth (NextAuth + Google) ----------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated admin allowlist and/or a Google Workspace domain.
ADMIN_EMAILS=you@example.com
ADMIN_EMAIL_DOMAIN=

# Local only: treat every visitor as admin. Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=false
